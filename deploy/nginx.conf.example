# nginx reverse-proxy alternative to Caddy (deploy/Caddyfile).
# Terminate TLS with certs from certbot or your provider.

server {
    listen 80;
    server_name tutorsat.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name tutorsat.example.com;

    ssl_certificate     /etc/letsencrypt/live/tutorsat.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tutorsat.example.com/privkey.pem;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;

    # Optional access control (app has no enforced login by default):
    # auth_basic "SAT Prep";
    # auth_basic_user_file /etc/nginx/satprep.htpasswd;

    location / {
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 75s;
        client_max_body_size 1m;
    }
}
